set_property(GLOBAL PROPERTY CMRX_ARCH arm)
set_property(GLOBAL PROPERTY CMRX_HAL cmsis)
set(DEVICE ${CMRX_DEVICE})

string(TOUPPER "${CMRX_DEVICE}" _CMRX_DEVICE_UPCASE)
string(TOLOWER "${CMRX_DEVICE}" _CMRX_DEVICE_LOWCASE)
add_definitions(-D${_CMRX_DEVICE_UPCASE})
add_definitions(-D${CMRX_DEVICE})

string(SUBSTRING "${CMRX_DEVICE}" 0 5 _NRF_FAMILY)
string(TOLOWER "${_NRF_FAMILY}" _NRF_FAMILY)
string(TOUPPER "${_NRF_FAMILY}" _NRF_FAMILY_UC)

string(SUBSTRING "${CMRX_DEVICE}" 0 8 _NRF_PART)
string(TOLOWER "${_NRF_PART}" _NRF_PART)
string(TOUPPER "${_NRF_PART}" _NRF_PART_UC)

set(SYSTEM_INCLUDE_FILENAME system_${_NRF_FAMILY}.h)
set(DEVICE_INCLUDE_FILENAME ${_NRF_FAMILY}.h)
set(SYSTEM_SOURCE_FILENAME system_${_NRF_FAMILY}.c)
set(STARTUP_SOURCE_FILENAME gcc_startup_${_NRF_FAMILY}.S)

# nrfx maintains current CPU frequency in SystemCoreClock
set(CMRX_SYSTICK_USE_SYSTEMCORECLOCK ON)

if (NOT NRFX_PATH)
    if (EXISTS ${CMAKE_SOURCE_DIR}/nrfx AND IS_DIRECTORY ${CMAKE_SOURCE_DIR}/nrfx)
        set(NRFX_PATH ${CMAKE_SOURCE_DIR}/nrfx)
    else()
        message(FATAL_ERROR "Variable NRFX_PATH not set and `nrfx` directory not found in project source directory. Either set NRFX_PATH or pass -DNRFX_PATH=<path> that points to nrfx install path.")
    endif()
else()
    if (EXISTS ${NRFX_PATH} AND NOT IS_DIRECTORY ${NRFX_PATH})
        message(FATAL_ERROR "Path ${NRFX_PATH} does not seem to contain nrfx installation!")
    endif()
endif()

if (NOT CMSIS_CORE_PATH)
    if (EXISTS ${CMAKE_SOURCE_DIR}/cmsis AND IS_DIRECTORY ${CMAKE_SOURCE_DIR}/cmsis)
        set(CMSIS_CORE_PATH ${CMAKE_SOURCE_DIR}/cmsis)
    else()
        message(FATAL_ERROR "Variable CMSIS_CORE_PATH not set and `cmsis` directory not found in project source directory. Either set CMSIS_CORE_PATH or pass -DCMSIS_CORE_PATH=<path> that points to CMSIS 4 install path.")
    endif()
else()
    if (EXISTS ${CMSIS_CORE_PATH} OR NOT IS_DIRECTORY ${CMSIS_CORE_PATH})
        message(FATAL_ERROR "Path ${CMSIS_CORE_PATH} does not seem to contain nrfx installation!")
    endif()
endif()

set(CMSIS_ROOT ${NRFX_PATH}/bsp/stable/mdk)
set(CMSIS_CORE_ROOT ${CMSIS_CORE_PATH})

if (DEFINED CMRX_LINKER_FILE)
    if (NOT EXISTS "${CMRX_LINKER_FILE}")
        message(FATAL_ERROR "Specified linker file doesn't exist: ${CMRX_LINKER_FILE}")
    endif()
    set(CMSIS_LINKER_FILE "${CMRX_LINKER_FILE}")
else()
    set(_LINKER_PATH "${CMSIS_ROOT}/${_NRF_FAMILY}/*/${_CMRX_DEVICE_LOWCASE}*.ld")
    message("Globbing: ${_LINKER_PATH}")
    file(GLOB CMSIS_LINKER_FILE LIST_DIRECTORIES false "${_LINKER_PATH}")
    list(LENGTH CMSIS_LINKER_FILE _LINKER_FILES_FOUND)
    message("Linker files: ${CMSIS_LINKER_FILE}")
    if (NOT "${_LINKER_FILES_FOUND}" STREQUAL 1)
        message(FATAL_ERROR "Unable to identify project linker file automatically! Either set variable `CMRX_LINKER_FILE` to contain path to linker file used or place exactly one linker file having pattern ${_STM_FAMILY}*.ld into ${CMAKE_SOURCE_DIR}")
    endif()
endif()

include(${CMAKE_CURRENT_LIST_DIR}/../FindCMSIS.cmake)

if (CMAKE_PROJECT_NAME)
    if (NOT CMAKE_TOOLCHAIN_FILE)
        message(FATAL_ERROR "Nordic Semiconductor platform support is active and no toolchain file has been specified. CMRX.cmake must be included before project is created!")
    endif()
endif()

set(CMAKE_TOOLCHAIN_FILE ${CMAKE_CURRENT_LIST_DIR}/nrf/toolchain-arm-gcc.cmake)
